{
  "name": "windy10v10ai-firebase",
  "version": "1.0.0",
  "private": true,
  "description": "Save windy 10v10ai data in cloud.",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "run-p build:*",
    "build:api": "cd api && npm run build",
    "build:web": "cd web && npm run build",
    "skills:link": "node scripts/link-agent-skills.mjs",
    "skills:check": "node scripts/check-agent-skills.mjs",
    "start": "run-p start:*",
    "start:api": "cd api && npm run start:debug",
    "start:web": "cd web && npm run dev",
    "start:firebase": "firebase emulators:start --only functions,hosting,firestore,auth --import ./firestore-backup",
    "postinstall": "run-s postinstall:*",
    "postinstall:api": "cd api && npm install",
    "postinstall:web": "cd web && npm install"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/windy10v10ai/firebase.git"
  },
  "author": "windy",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/windy10v10ai/firebase/issues"
  },
  "homepage": "https://github.com/windy10v10ai/firebase#readme",
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
