<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>WindyMacEngine</AssemblyName>
    <NoWarn>SYSLIB0014;SYSLIB0039;CS0649;CS0414</NoWarn>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LauncherTests)' == 'true'">
    <DefineConstants>$(DefineConstants);LAUNCHER_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" Condition="'$(LauncherTests)' != 'true'" />
    <Compile Include="../core/*.cs" Link="Core/%(Filename)%(Extension)" />
    <Compile Condition="'$(LauncherTests)' == 'true'" Include="../core/tests/*.cs" Link="Tests/Core/%(Filename)%(Extension)" />
    <Compile Include="../core/dotnet/JsonCompatibility.cs" Link="Core/JsonCompatibility.cs" />
  </ItemGroup>
</Project>
